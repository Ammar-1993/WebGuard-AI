# استخدام نسخة Node.js الخفيفة (Alpine) لتقليل حجم الحاوية وسرعة البناء
# تم اختيار الإصدار 22 ليتوافق تماماً مع البيئة المحلية لجهازك التي فحصناها سابقاً
FROM node:22-alpine

# تحديد مجلد العمل
WORKDIR /app

# نسخ ملفات تعريف المشروع أولاً (لاستغلال الكاش وتسريع التثبيت)
COPY package.json package-lock.json* ./

# تثبيت المكتبات (Dependencies)
RUN npm install

# نسخ باقي ملفات المشروع (مثل مجلد src)
COPY . .

# فتح المنفذ المعتمد لواجهة المستخدم
EXPOSE 3030

# أمر تشغيل خادم Next.js في وضع التطوير (Development Mode)
# هذا يسمح للطلاب بتعديل الكود ورؤية التغييرات مباشرة أثناء المناقشة دون الحاجة لإعادة بناء الحاوية
CMD ["npm", "run", "dev", "-p", "3030"]